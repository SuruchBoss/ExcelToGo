# Optional: enables the AI formula assistant to use Claude instead of the
# built-in keyword-based fallback. Without this set, /api/ai/formula still
# works using simple keyword matching, and visitors can still bring their own key
# (it goes from their browser straight to Anthropic, never through this server).
#
# WARNING — on a PUBLIC deployment, everyone who uses the site uses the assistant on
# THIS key and YOUR bill. The route takes no login, and its per-IP rate limit is a
# speed bump, not a billing control. NEXT_PUBLIC_DEMO_MODE no longer hides this key
# (#109). The only billing control is leaving it unset where the public can reach it.
ANTHROPIC_API_KEY=

# Required to switch SERVER-SIDE live-data sources on at all (REST/CSV fetched by this server, and
# PostgreSQL/MySQL). With this unset the UI does not show them and /api/sources and friends refuse
# every request with 403 — they can tell the server to fetch a URL, so the default is off rather than
# open. Connecting an API from the browser needs none of this and works for everyone.
# On a PUBLIC deployment, leave it unset unless you mean to run server-side sources there.
# Send it from a client as X-Sources-Token or Authorization: Bearer.
# Generate one with:  openssl rand -base64 32
SOURCES_ADMIN_TOKEN=

# Required before a source credential (an auth header) can be stored. It is encrypted with
# AES-256-GCM under this key; without it the app refuses to save one rather than writing it in the
# clear. Any passphrase works — it is hashed to a 32-byte key.
SOURCES_SECRET_KEY=

# Optional: narrow which hosts a data source may point at, on top of the private-address blocking
# that always applies. Comma-separated, e.g. api.example.com,data.example.com
SOURCES_ALLOWED_HOSTS=

# Optional, and a deliberate loosening rather than a narrowing — read SECURITY.md before using it.
# A DATABASE source (PostgreSQL/MySQL) is refused a private address like every other source, and a
# database inside a VPC is the normal case, so naming its host here is how an operator says the
# server may reach it. Nothing a browser sends can add to this list.
# Comma-separated, e.g. db.internal,10-0-1-5.rds.example.com
SOURCES_ALLOWED_DB_HOSTS=

# Optional: where the crash screen posts a scrubbed report, so a bug that only fires on one
# imported file is not something you find out about never. Unset on every deployment that has not
# chosen otherwise, including the public site. See src/lib/errorReport.ts for the fixed list of what a
# report may contain — the stack is scrubbed of keys, tokens, emails and Thai text before it goes.
NEXT_PUBLIC_ERROR_REPORT_URL=

# Optional: the canonical public URL, used by metadata, the sitemap and robots.txt. Falls back to
# the Vercel project URL in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Kept for older deployments only. "1" now means exactly one thing: server-side live-data sources
# are off, even if SOURCES_ADMIN_TOKEN is set. It shows users nothing and no longer affects the AI
# assistant (#109). Before removing it from a public deployment, confirm that ANTHROPIC_API_KEY and
# SOURCES_ADMIN_TOKEN are NOT set there. See src/lib/demoMode.ts.
NEXT_PUBLIC_DEMO_MODE=

# Optional: cloud save, bring your own backend.
#
# ExcelToGo is open source, not a hosted service — there is no shared database, and the public site
# leaves these unset. Point them at YOUR OWN Supabase project and a "Cloud save" button appears;
# leave them blank and the app is exactly what it was, with your sheets living only in the browser
# and the Supabase client never downloaded at all.
#
# Run supabase/migrations/0001_workbooks.sql against your project first — it creates the table and
# the row-level security policies that keep one account's workbooks away from another's.
#
# The anon key is meant to be public: it reaches the browser by design, and row-level security is
# what protects the data. Do NOT put a service-role key here — it bypasses every policy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Usage counting -----------------------------------------------------------------------------
#
# Answers one question — has anyone actually used this — and nothing else. Off unless the first
# line below is exactly "1": a clone of this repo sends nothing, ever. Read the "usage count"
# section of SECURITY.md before switching it on; the short version is that what travels is one
# event name from a closed list of six, at most once per page load, with no time of day, no IP, no
# user agent, no referrer, no cookie and no session, and that Do Not Track is honoured.
NEXT_PUBLIC_USAGE=

# Where the counts are kept. Leave both blank and the server writes one structured log line per
# event instead, which on a host that keeps logs for an hour is worth exactly that much.
#
# Run supabase/migrations/0004_usage.sql against the project first. That file stands alone — a
# deployment that wants a usage count but no cloud save can run it without 0001-0003.
#
# Use the ANON key, not a service-role key. The table has row-level security on and no policy at
# all, so this key can call bump_usage() and cannot read a single row back; that is the point, and
# a service-role key would throw it away.
USAGE_SUPABASE_URL=
USAGE_SUPABASE_KEY=

# --- Knobs the gates read (scripts/), none of them needed to run the app -------------------------
#
# A11Y_PORT / E2E_PORT     the port each browser gate starts its own server on
# BUNDLE_TOTAL_KB / BUNDLE_LARGEST_KB   the written size budgets check:bundle enforces
# MUTATION_FLOOR           the percentage of mutants check:mutants must kill
# APP_URL                  point check:e2e at an already-running server instead of starting one
# RLS_USER_A_EMAIL / RLS_USER_A_PASSWORD / RLS_USER_B_EMAIL / RLS_USER_B_PASSWORD
#                          two accounts on YOUR Supabase project, for `npm run check:rls`
